generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model EventLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sessionId     String?
  participantId String?
  phase         String?

  setIndex  Int?
  taskSetId String?
  trialNo   Int?

  page String
  type String
  ts   BigInt

  meta    Json
  payload Json

  @@index([sessionId])
  @@index([participantId])
  @@index([phase])
  @@index([setIndex])
  @@index([taskSetId])
  @@index([trialNo])
  @@index([page])
  @@index([type])
  @@index([createdAt])
}